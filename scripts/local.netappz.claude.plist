<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Every 5 minutes, processes requests sent to Claude. Install: see README "Requests processed by Claude". -->
<plist version="1.0">
<dict>
  <key>Label</key><string>local.netappz.claude</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/emr/py/p1/scripts/claude-worker.sh</string>
  </array>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/netappz-claude.log</string>
  <key>StandardErrorPath</key><string>/tmp/netappz-claude.log</string>
</dict>
</plist>

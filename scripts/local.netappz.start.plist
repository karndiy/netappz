<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Starts Docker and Network Files at login. Install: see README "Start when the Mac turns on". -->
<plist version="1.0">
<dict>
  <key>Label</key><string>local.netappz.start</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/emr/py/p1/scripts/netappz-start.sh</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/netappz-start.log</string>
  <key>StandardErrorPath</key><string>/tmp/netappz-start.log</string>
</dict>
</plist>

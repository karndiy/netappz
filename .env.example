# Copy this file to .env and fill in the values, then run: docker-compose up -d

# Chat with Claude: create a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Telegram bot (optional): create a bot with @BotFather and paste its token.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the bot. Message the bot once
# and it replies with your ID.
TELEGRAM_ALLOWED_USERS=

# Optional: keep sessions valid across restarts.
FILES_SECRET_KEY=
